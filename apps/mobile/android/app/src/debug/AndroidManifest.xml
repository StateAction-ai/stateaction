<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug qualification only. The uploader gate is false unless the build
         passes -PstateactionNativeUpload=true; cleartext loopback is a separate
         switch (-PstateactionNativeUploadCleartext=true, emulator e2e package
         only). This overlay does not exist in release builds, whose merged
         manifest keeps the plugin defaults (false). -->
    <application android:usesCleartextTraffic="${nativeUploadCleartext}">
        <meta-data
            android:name="ai.stateaction.native_upload.enabled"
            android:value="${nativeUploadEnabled}"
            tools:replace="android:value" />
        <meta-data
            android:name="ai.stateaction.native_upload.allow_cleartext_loopback"
            android:value="${nativeUploadCleartext}"
            tools:replace="android:value" />
    </application>
</manifest>
