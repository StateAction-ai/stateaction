{
  "name": "mobile-backend-e2e",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "root": "apps/mobile/test_backend/e2e",
  "projectType": "application",
  "tags": ["mobile-toolchain"],
  "implicitDependencies": [
    "mobile-auth-backend-e2e",
    "mobile",
    "web",
    "server",
    "contracts"
  ],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "dependsOn": [
        {
          "projects": ["web"],
          "target": "build"
        }
      ],
      "inputs": [
        "{workspaceRoot}/apps/mobile/test_backend/**/*",
        "^fixtureProduction",
        "flutterSources",
        "{workspaceRoot}/packages/server/test-auth/**/*",
        "{workspaceRoot}/scripts/platform/local-fixtures.mjs",
        "{workspaceRoot}/scripts/platform/process-wait.mjs",
        "flutterToolchain",
        "!{projectRoot}/**/*.md",
        "!{workspaceRoot}/scripts/mobile/**/*.md"
      ],
      "options": {
        "commands": [
          "python3 scripts/mobile/run.py mobile prepare",
          "node apps/mobile/test_backend/run_real_backend.mjs"
        ],
        "parallel": false
      }
    }
  }
}
