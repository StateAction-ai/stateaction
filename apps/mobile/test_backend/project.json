{
  "name": "mobile-auth-backend-e2e",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "root": "apps/mobile/test_backend",
  "projectType": "application",
  "implicitDependencies": ["mobile"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "python3 scripts/mobile/run.py mobile prepare",
          "cd apps/mobile && flutter analyze --no-pub test_backend"
        ],
        "parallel": false
      },
      "inputs": [
        "default",
        "^production",
        "flutterToolchain",
        "{workspaceRoot}/scripts/mobile/**/*"
      ],
      "dependsOn": []
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "dart format --output=none --set-exit-if-changed --language-version=3.9 apps/mobile/test_backend",
          "pnpm exec prettier --check apps/mobile/test_backend"
        ],
        "parallel": false
      },
      "inputs": ["default", "prettier", "flutterToolchain"]
    }
  },
  "tags": ["mobile-toolchain"]
}
