{
  "name": "mobile-auth-backend-e2e",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "root": "apps/mobile/test_backend",
  "projectType": "application",
  "implicitDependencies": ["mobile", "web", "server", "contracts"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["mobile"], "target": "prepare" }],
      "options": {
        "command": "flutter analyze --no-pub test_backend",
        "cwd": "apps/mobile"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "dart format --output=none --set-exit-if-changed --language-version=3.9 apps/mobile/test_backend",
          "pnpm exec prettier --check apps/mobile/test_backend"
        ],
        "parallel": false
      }
    },
    "mobile-backend-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        { "projects": ["mobile"], "target": "prepare" },
        { "projects": ["web"], "target": "build" }
      ],
      "options": {
        "command": "node apps/mobile/test_backend/run_real_backend.mjs"
      }
    }
  }
}
