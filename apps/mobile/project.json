{
  "name": "mobile",
  "root": "apps/mobile",
  "projectType": "application",
  "implicitDependencies": ["stera-recorder", "contracts-dart", "contracts"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "inputs": ["flutterSources", "^flutterSources"],
      "options": {
        "command": "python3 scripts/mobile/run.py mobile typecheck"
      },
      "dependsOn": []
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["flutterSources", "^flutterSources"],
      "options": {
        "command": "python3 scripts/mobile/run.py mobile test"
      },
      "dependsOn": []
    },
    "format": {
      "executor": "nx:run-commands",
      "inputs": ["flutterSources"],
      "options": {
        "command": "python3 scripts/mobile/run.py mobile format"
      },
      "dependsOn": []
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["flutterSources", "^flutterSources", "androidToolchain"],
      "outputs": [],
      "options": {
        "command": "python3 scripts/mobile/run.py mobile build"
      }
    }
  },
  "tags": ["mobile-toolchain"]
}
