# Auth-free capture harness: true disables login, uploads and all networking.
NO_AUTH_MODE=false

ENVIRONMENT=dev

# Exact backend origin (scheme://host[:port], no path). Better Auth is served
# at <origin>/api/auth and the API at <origin>/api/v1. Session cookies are
# bound to this exact origin. Plain http is accepted only for loopback and the
# Android emulator alias 10.0.2.2.
DEV_BACKEND_ORIGIN=https://tim-work-pc.taila68f99.ts.net:8444
PROD_BACKEND_ORIGIN=

# Opt-in local email/password sign-in (seeded pilot users on the same Better
# Auth instance). Keep false for builds that must only offer Google.
LOCAL_PASSWORD_AUTH=false

# Owner-bound native Android upload (needs the native build gate too). Keep
# false until the joined path is reviewed.
OWNER_NATIVE_UPLOAD=false

APPLE_SIGN_IN=true

GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

DEMO_VIDEO_URL=
