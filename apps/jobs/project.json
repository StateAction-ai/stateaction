{
  "name": "jobs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "apps/jobs",
  "sourceRoot": "apps/jobs/src",
  "projectType": "application",
  "implicitDependencies": ["contracts", "processing", "server", "web"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @stateaction/jobs build"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @stateaction/jobs typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @stateaction/jobs test"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec prettier --check \"apps/jobs/src/**/*\" \"apps/jobs/test/**/*\" \"apps/jobs/*.json\""
      },
      "inputs": ["default", "prettier"]
    },
    "integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "dependsOn": [
        "^build",
        {
          "projects": ["server", "web"],
          "target": "build"
        }
      ],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/packages/server/test-auth/**/*",
        "{workspaceRoot}/scripts/platform/local-fixtures.mjs"
      ],
      "options": {
        "command": "pnpm --filter @stateaction/jobs test:integration"
      }
    }
  },
  "namedInputs": {
    "externalDeps": [
      {
        "externalDependencies": [
          "npm:@renderinc/sdk",
          "npm:@types/node",
          "npm:modal",
          "npm:tsx",
          "npm:typescript"
        ]
      }
    ]
  }
}
