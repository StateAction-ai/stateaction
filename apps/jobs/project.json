{
  "name": "jobs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "apps/jobs",
  "sourceRoot": "apps/jobs/src",
  "projectType": "application",
  "implicitDependencies": ["contracts", "processing"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @stateaction/jobs build"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @stateaction/jobs typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @stateaction/jobs test"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec prettier --check \"apps/jobs/src/**/*\" \"apps/jobs/test/**/*\" \"apps/jobs/*.json\""
      }
    }
  }
}
