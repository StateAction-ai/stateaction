{
  "name": "@stateaction/jobs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=2 --test-timeout=120000 test/*.test.ts",
    "smoke": "node --env-file=../../.env --import tsx src/smoke.ts",
    "test:integration": "node --test --test-concurrency=1 --test-timeout=300000 test-integration/*.test.mjs"
  },
  "dependencies": {
    "@stateaction/contracts": "workspace:*",
    "@renderinc/sdk": "1.6.0"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
