{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "apps/web",
  "sourceRoot": "apps/web/app",
  "projectType": "application",
  "implicitDependencies": ["server", "contracts"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @stateaction/web build"
      },
      "outputs": ["{projectRoot}/.next"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @stateaction/web typecheck"
      },
      "dependsOn": ["build"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @stateaction/web test"
      },
      "dependsOn": ["^build"]
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec prettier --check \"apps/web/app/**/*\" \"apps/web/test/**/*\" \"apps/web/*.json\" \"apps/web/next.config.ts\""
      }
    }
  }
}
