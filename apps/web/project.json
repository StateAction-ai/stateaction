{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "apps/web",
  "sourceRoot": "apps/web/app",
  "projectType": "application",
  "implicitDependencies": ["server", "contracts"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @stateaction/web build"
      },
      "outputs": ["{projectRoot}/.next", "{projectRoot}/public/rerun"],
      "parallelism": false,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/scripts/platform/rerun-assets.mjs"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @stateaction/web exec tsc --noEmit"
      },
      "dependsOn": ["build"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @stateaction/web test"
      },
      "dependsOn": ["^build"]
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec prettier --check \"apps/web/app/**/*\" \"apps/web/test/**/*\" \"apps/web/test-e2e/**/*\" \"apps/web/*.json\" \"apps/web/next.config.ts\""
      },
      "inputs": ["default", "{workspaceRoot}/.prettierignore", "prettier"]
    },
    "auth-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node --test --test-concurrency=1 test-e2e/*.test.mjs",
        "cwd": "apps/web"
      },
      "parallelism": false,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/packages/server/test-auth/**/*",
        "{workspaceRoot}/scripts/platform/local-fixtures.mjs",
        "{workspaceRoot}/scripts/platform/process-wait.mjs"
      ]
    }
  },
  "namedInputs": {
    "externalDeps": [
      {
        "externalDependencies": [
          "npm:@radix-ui/react-dropdown-menu",
          "npm:@radix-ui/react-slot",
          "npm:@rerun-io/web-viewer",
          "npm:@tailwindcss/postcss",
          "npm:@types/node",
          "npm:@types/react",
          "npm:@types/react-dom",
          "npm:class-variance-authority",
          "npm:clsx",
          "npm:lucide-react",
          "npm:next",
          "npm:postcss@8.5.32",
          "npm:react",
          "npm:react-dom",
          "npm:server-only",
          "npm:tailwind-merge",
          "npm:tailwindcss",
          "npm:typescript"
        ]
      }
    ]
  }
}
