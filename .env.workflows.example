# Render's local runtime receives NO database or storage credentials: only the API URL and a
# protected controller credential file. Issue the credential with the operator CLI (owner
# database credential, outside any request path), e.g.
#   pnpm --filter @stateaction/server exec ... issue-service-capability --kind workflow \
#     --scopes jobs:status,jobs:reconcile --label local-controller --out <new 0600 file>
# The file must be owner-only (0600); the controller refuses group/world-readable files.
APP_ENV=local
EXECUTION_BACKEND=local
RENDER_USE_LOCAL_DEV=true
RENDER_LOCAL_DEV_URL=http://127.0.0.1:8120
STATEACTION_API_URL=http://127.0.0.1:3000
CONTROLLER_CAPABILITY_FILE=
# Private 0700 directory for the local execution journal (never committed, never shared).
JOBS_STATE_DIR=
# Python worker interpreter (uv sync --project workers/processing --locked).
PYTHON_EXECUTABLE=
# Production pipeline name. The extractor stack (PR27/28/31) is not part of SA-26, so the worker
# fails closed BEFORE claiming. local_fixture_noop is a local-only controller-plumbing fixture
# that produces no output; never use it as processing.
WORKER_PIPELINE=hand_pose_cpu_v1
# Hosted Render only (dispatcher/cron, not the workflow service): PROCESS_RECORDING_TASK_SLUG=<workflow-slug>/process-recording
# plus RENDER_API_KEY. Local runner uses the bare task name. Idempotency keys are scoped to one workflow version for 24 h.
