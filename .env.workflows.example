# Render's local runtime receives NO database or storage credentials: only the API URL and a
# protected controller credential file. Issue the credential with the operator CLI (owner
# database credential, outside any request path), e.g.
#   pnpm --filter @stateaction/server exec ... issue-service-capability --kind workflow \
#     --scopes jobs:status,jobs:reconcile --label local-controller --out <new 0600 file>
# The file must be owner-only (0600); the controller refuses group/world-readable files.
APP_ENV=local
EXECUTION_BACKEND=local
RENDER_USE_LOCAL_DEV=true
RENDER_LOCAL_DEV_URL=http://127.0.0.1:8120
STATEACTION_API_URL=http://127.0.0.1:3000
CONTROLLER_CAPABILITY_FILE=
# Private 0700 directory for the local execution journal (never committed, never shared).
JOBS_STATE_DIR=
# Python worker interpreter (uv sync --project workers/processing --locked).
PYTHON_EXECUTABLE=
# Local controller integration uses local_fixture_noop, which emits no output.
# hand_pose_cpu_v1 requires the extractor and a qualified containment strategy.
WORKER_PIPELINE=local_fixture_noop
# Set RENDER_API_KEY and PROCESS_RECORDING_TASK_SLUG=<workflow-slug>/process-recording
# on the hosted API (web) service only. Render scopes idempotency keys to one
# workflow version for 24 hours.
# For local runs, set APP_ENV=local, RENDER_USE_LOCAL_DEV=true and
# RENDER_LOCAL_DEV_URL on the API. The task name is process-recording.
# The repair cron needs STATEACTION_API_URL and one of REPAIR_CAPABILITY_FILE
# or REPAIR_CAPABILITY_TOKEN.
# SA-42 Modal executor (development/production hosts only; never with APP_ENV=local). Set
# EXECUTION_BACKEND=modal and APP_ENV=development|production, a non-loopback https STATEACTION_API_URL,
# and the controller-only Modal credential below. Nothing in this repository deploys Modal.
# MODAL_APP_NAME=stateaction-processing
# MODAL_FUNCTION_NAME=process_recording
# MODAL_STAGE_FUNCTIONS=module@1=app/function,...   (FLORA GPU stages: workers/flora controller_env())
# MODAL_ENVIRONMENT=
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
