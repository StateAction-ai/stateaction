# Local development only. Never copy these example credentials to hosted services.
APP_ENV=local
DATABASE_URL=postgresql://stateaction:stateaction-local-only@127.0.0.1:54329/stateaction
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=stateaction-local
S3_ACCESS_KEY_ID=stateaction-local
S3_SECRET_ACCESS_KEY=stateaction-local-only-secret
RENDER_USE_LOCAL_DEV=true
RENDER_LOCAL_DEV_URL=http://127.0.0.1:8120
# Replace locally; the development dispatch endpoint requires this bearer token.
LOCAL_SMOKE_TOKEN=replace-with-a-local-random-token
