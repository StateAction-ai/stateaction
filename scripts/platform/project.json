{
  "name": "tooling",
  "root": "scripts/platform",
  "projectType": "library",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node --test --test-concurrency=2 scripts/platform/check-staged.test.mjs",
          "node --test --test-concurrency=2 scripts/platform/local-fixtures.test.mjs",
          "node --test --test-concurrency=2 scripts/platform/r2-qualification.test.mjs scripts/platform/r2-qualification-run.test.mjs",
          "python3 -m unittest discover -s scripts/platform -p 'test_mobile*.py' -v",
          "node --test --test-concurrency=1 scripts/platform/check-staged-dart.test.mjs"
        ],
        "parallel": false
      },
      "inputs": ["default", "flutterToolchain"]
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pnpm exec prettier --check \"scripts/platform/**/*.{mjs,json,md}\" scripts/local-ci/stages.json docs/local-ci.md \"config/**/*.json\" package.json nx.json pnpm-workspace.yaml lefthook.yml \".github/workflows/*.yml\" AGENTS.md README.md docs/repository-workflow.md .github/pull_request_template.md pnpm-lock.yaml",
          "uv run --project workers/processing --locked ruff format --check --config workers/processing/pyproject.toml scripts/local-ci/*.py scripts/platform/install-render.py scripts/platform/install-mobile-toolchain.py scripts/platform/runner_disk.py scripts/platform/test_mobile_bootstrap.py scripts/platform/test_mobile_runner_disk.py"
        ],
        "parallel": false
      },
      "inputs": [
        "default",
        "repositoryDocs",
        "automationSources",
        "repositoryConfig",
        "{workspaceRoot}/scripts/local-ci/**/*",
        "!{workspaceRoot}/scripts/local-ci/**/__pycache__/**/*",
        "prettier"
      ]
    },
    "syntax": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node --check scripts/platform/check-staged.mjs",
          "node --check scripts/platform/check-push.mjs",
          "node --check scripts/platform/install-hooks.mjs",
          "node --check scripts/platform/local-fixtures.mjs",
          "node --check scripts/platform/local-fixtures.test.mjs",
          "node --check scripts/platform/hook-fixtures.mjs",
          "node --check scripts/platform/qualify-r2-transfers.mjs",
          "node --check scripts/platform/r2-qualification-lib.mjs",
          "node --check scripts/platform/r2-qualification-run.mjs",
          "node --check scripts/platform/r2-qualification-run.test.mjs",
          "node --check scripts/platform/r2-qualification.test.mjs",
          "node --check scripts/platform/check-staged-dart.test.mjs",
          "uv run --project workers/processing --locked ruff check --config workers/processing/pyproject.toml scripts/local-ci/*.py scripts/platform/install-render.py scripts/platform/install-mobile-toolchain.py scripts/platform/runner_disk.py scripts/platform/test_mobile_bootstrap.py scripts/platform/test_mobile_runner_disk.py"
        ],
        "parallel": false
      }
    },
    "test-local-ci": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/local-ci/**/*",
        "!{workspaceRoot}/scripts/local-ci/**/__pycache__/**/*",
        "{workspaceRoot}/scripts/platform/install-render.py",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/**/project.json",
        "{workspaceRoot}/pnpm-workspace.yaml",
        "jsToolchain",
        "pythonToolchain",
        "{workspaceRoot}/**/package.json",
        "{workspaceRoot}/pnpm-lock.yaml",
        "externalDeps"
      ],
      "options": {
        "command": "python3 -m unittest discover -s scripts/local-ci -p 'test_*.py'"
      }
    }
  }
}
