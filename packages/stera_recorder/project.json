{
  "name": "stera-recorder",
  "root": "packages/stera_recorder",
  "projectType": "library",
  "targets": {
    "prepare": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "python3 scripts/mobile/run.py stera-recorder prepare"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["prepare"],
      "inputs": ["flutterSources"],
      "options": {
        "command": "python3 scripts/mobile/run.py stera-recorder typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["prepare"],
      "inputs": ["flutterSources"],
      "options": {
        "command": "python3 scripts/mobile/run.py stera-recorder test"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "dependsOn": ["prepare"],
      "inputs": ["flutterSources"],
      "options": {
        "command": "python3 scripts/mobile/run.py stera-recorder format"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "prepare",
        {
          "target": "prepare",
          "projects": ["mobile"]
        }
      ],
      "inputs": [
        "flutterSources",
        "{workspaceRoot}/apps/mobile/android/**/*",
        "!{workspaceRoot}/apps/mobile/android/.gradle/**/*",
        "!{workspaceRoot}/apps/mobile/android/local.properties",
        "{workspaceRoot}/apps/mobile/pubspec.lock",
        "!{workspaceRoot}/apps/mobile/android/.kotlin/**/*",
        "!{workspaceRoot}/apps/mobile/android/**/.cxx/**/*"
      ],
      "outputs": ["{workspaceRoot}/apps/mobile/build/stera_recorder"],
      "options": {
        "command": "python3 scripts/mobile/run.py stera-recorder build"
      }
    }
  },
  "tags": ["mobile-toolchain"]
}
