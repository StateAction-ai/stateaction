{
  "name": "@stateaction/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./display-name": {
      "types": "./dist/auth/display-name.d.ts",
      "default": "./dist/auth/display-name.js"
    },
    "./client-address": {
      "types": "./dist/auth/client-address.d.ts",
      "default": "./dist/auth/client-address.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./annotations": {
      "types": "./dist/annotations/next.d.ts",
      "default": "./dist/annotations/next.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline/next.d.ts",
      "default": "./dist/pipeline/next.js"
    },
    "./pipeline-model": {
      "types": "./dist/pipeline/model.d.ts",
      "default": "./dist/pipeline/model.js"
    },
    "./recordings": {
      "types": "./dist/admission/next.d.ts",
      "default": "./dist/admission/next.js"
    },
    "./source-cleanup": {
      "types": "./dist/source-cleanup/next.d.ts",
      "default": "./dist/source-cleanup/next.js"
    },
    "./datasets": {
      "types": "./dist/datasets/next.d.ts",
      "default": "./dist/datasets/next.js"
    },
    "./uploads": {
      "types": "./dist/transport/next.d.ts",
      "default": "./dist/transport/next.js"
    },
    "./jobs": {
      "types": "./dist/jobs/next.d.ts",
      "default": "./dist/jobs/next.js"
    },
    "./operator-db": {
      "types": "./dist/jobs/operator-db.d.ts",
      "default": "./dist/jobs/operator-db.js"
    },
    "./ops": {
      "types": "./dist/ops/index.d.ts",
      "default": "./dist/ops/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --conditions=react-server --import tsx --test --test-concurrency=2 test/*.test.ts",
    "test:auth": "NODE_ENV=test node --conditions=react-server --import tsx --test --test-concurrency=$(node ../../scripts/platform/test-workers.mjs server-auth-integration) test-auth/*.test.ts",
    "migrate": "node --conditions=react-server --env-file=../../.env --import tsx src/cli.ts migrate",
    "seed": "node --conditions=react-server --env-file=../../.env --import tsx src/cli.ts seed",
    "catalog-integration": "bash scripts/catalog-integration.sh",
    "storage:init": "node --conditions=react-server --env-file=../../.env --import tsx src/cli.ts storage-init",
    "storage:check": "node --conditions=react-server --env-file=../../.env --import tsx src/cli.ts storage-check",
    "hosted:migrate": "node dist/cli.js migrate",
    "hosted:preflight": "node dist/cli.js preflight",
    "hosted:storage-check": "node dist/cli.js storage-check",
    "storage:presign": "node --conditions=react-server --env-file=../../.env --import tsx src/cli.ts presign-check",
    "hosted:presign-check": "node dist/cli.js presign-check",
    "dataset-sharing": "node --conditions=react-server --env-file-if-exists=../../.env --import tsx src/dataset-sharing-cli.ts",
    "ops-report": "node --conditions=react-server --env-file-if-exists=../../.env --import tsx src/ops-report-cli.ts",
    "restore-check": "node --conditions=react-server --env-file-if-exists=../../.env --import tsx src/restore-check-cli.ts",
    "job-recovery": "node --conditions=react-server --env-file-if-exists=../../.env --import tsx src/job-recovery-cli.ts",
    "ingest-permission": "node --conditions=react-server --env-file-if-exists=../../.env --import tsx src/ingest-permission-cli.ts",
    "cached-import": "node --conditions=react-server --import tsx src/cached-import-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@renderinc/sdk": "1.6.0",
    "@stateaction/contracts": "workspace:*",
    "better-auth": "1.7.15",
    "pg": "8.23.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "@types/pg": "8.15.6",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
