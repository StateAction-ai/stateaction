{
  "name": "@stateaction/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./display-name": {
      "types": "./dist/auth/display-name.d.ts",
      "default": "./dist/auth/display-name.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./recordings": {
      "types": "./dist/admission/next.d.ts",
      "default": "./dist/admission/next.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --conditions=react-server --import tsx --test test/*.test.ts",
    "test:auth": "NODE_ENV=test node --conditions=react-server --import tsx --test --test-concurrency=1 test-auth/*.test.ts",
    "test:catalog": "node --conditions=react-server --import tsx --test --test-concurrency=4 test-integration/*.test.ts",
    "migrate": "node --conditions=react-server --env-file=../../.env --import tsx src/cli.ts migrate",
    "seed": "node --conditions=react-server --env-file=../../.env --import tsx src/cli.ts seed",
    "integration": "bash scripts/catalog-integration.sh",
    "storage:init": "node --conditions=react-server --env-file=../../.env --import tsx src/cli.ts storage-init",
    "storage:check": "node --conditions=react-server --env-file=../../.env --import tsx src/cli.ts storage-check",
    "hosted:migrate": "node dist/cli.js migrate",
    "hosted:preflight": "node dist/cli.js preflight",
    "hosted:storage-check": "node dist/cli.js storage-check",
    "storage:presign": "node --conditions=react-server --env-file=../../.env --import tsx src/cli.ts presign-check",
    "hosted:presign-check": "node dist/cli.js presign-check",
    "ingest-permission": "node --conditions=react-server --env-file-if-exists=../../.env --import tsx src/ingest-permission-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@renderinc/sdk": "1.6.0",
    "@stateaction/contracts": "workspace:*",
    "better-auth": "1.7.15",
    "pg": "8.23.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "@types/pg": "8.15.6",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
