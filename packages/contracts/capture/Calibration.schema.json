{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateaction.ai/schemas/capture/v1/Calibration",
  "title": "stateaction.capture.Calibration.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recording_id",
    "calibration_id",
    "stream_id",
    "model",
    "saved_width",
    "saved_height",
    "K",
    "P",
    "source",
    "source_to_saved",
    "distortion",
    "first_source_frame_id",
    "first_native_timestamp_ns",
    "native_clock_id"
  ],
  "properties": {
    "recording_id": {
      "$ref": "#/$defs/uuid"
    },
    "calibration_id": {
      "$ref": "#/$defs/label"
    },
    "stream_id": {
      "const": "rgb"
    },
    "model": {
      "const": "pinhole"
    },
    "saved_width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16384
    },
    "saved_height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16384
    },
    "K": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "number",
        "minimum": -1000000000,
        "maximum": 1000000000
      }
    },
    "P": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "number",
        "minimum": -1000000000,
        "maximum": 1000000000
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "intrinsics_source", "value_type", "K"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "intrinsics_source": {
          "$ref": "#/$defs/label"
        },
        "value_type": {
          "enum": ["float32", "float64"]
        },
        "K": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "number",
            "minimum": -1000000000,
            "maximum": 1000000000
          }
        }
      }
    },
    "source_to_saved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crop",
        "scaled_width",
        "scaled_height",
        "rotation_cw_degrees",
        "mirror_horizontal",
        "operation_order",
        "pixel_center_convention",
        "matrix"
      ],
      "properties": {
        "crop": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "top", "width", "height"],
          "properties": {
            "left": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16383
            },
            "top": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16383
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            }
          }
        },
        "scaled_width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "scaled_height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "rotation_cw_degrees": {
          "const": 0
        },
        "mirror_horizontal": {
          "const": false
        },
        "operation_order": {
          "const": "crop,resize"
        },
        "pixel_center_convention": {
          "const": "integer_centers_assumed_not_verified_against_arcore"
        },
        "matrix": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "number",
            "minimum": -1000000000,
            "maximum": 1000000000
          }
        }
      }
    },
    "distortion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "assumed_model", "measured"],
      "properties": {
        "state": {
          "const": "not_exposed_by_source"
        },
        "assumed_model": {
          "const": "none"
        },
        "measured": {
          "const": false
        }
      }
    },
    "first_source_frame_id": {
      "$ref": "#/$defs/int64Decimal"
    },
    "first_native_timestamp_ns": {
      "$ref": "#/$defs/int64Decimal"
    },
    "native_clock_id": {
      "$ref": "#/$defs/clockDomain"
    }
  },
  "$defs": {
    "uuid": {
      "description": "Domain entity identifier: canonical lowercase RFC 9562 UUID, versions 1-8.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "int64Decimal": {
      "description": "Exact non-negative signed 64-bit integer as a decimal string (0..9223372036854775807); used for nanosecond timestamps, PTS and native counters.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$"
    },
    "clockDomain": {
      "description": "Named native clock domain (for example android.elapsed_realtime or android.sensor_event). Timestamps from different domains are never merged.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}(\\.[a-z][a-z0-9_]{0,31}){0,3}$"
    },
    "revision": {
      "description": "Code, profile or rule revision label.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
    },
    "uint32": {
      "description": "MCAP message sequence (uint32).",
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "label": {
      "description": "Textual label (calibration ID, sensor/stream ID, kind, model, reason code). Intentionally not a UUID.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "text": {
      "description": "Bounded human-readable diagnostic: 1..256 printable ASCII characters.",
      "type": "string",
      "maxLength": 256,
      "pattern": "^[ -~]{1,256}$"
    },
    "timeBase": {
      "description": "Encoder PTS time base: exactly 1/1000000 seconds.",
      "const": {
        "numerator": 1,
        "denominator": 1000000
      }
    }
  }
}
