{
  "contract": "http.profile-update.v1",
  "cases": [
    {
      "name": "plain name",
      "input": {
        "document": {
          "name": "Pilot Staff"
        }
      },
      "expect": {
        "valid": true
      }
    },
    {
      "name": "single character",
      "input": {
        "document": {
          "name": "A"
        }
      },
      "expect": {
        "valid": true
      }
    },
    {
      "name": "non-latin and astral code points",
      "input": {
        "document": {
          "name": "\u674e\u96f7 \ud83d\ude00"
        }
      },
      "expect": {
        "valid": true
      }
    },
    {
      "name": "surrounding whitespace is a service trim, not a wire error",
      "input": {
        "document": {
          "name": "  Pilot  "
        }
      },
      "expect": {
        "valid": true
      }
    },
    {
      "name": "wire bound 1013 code points",
      "input": {
        "document": {
          "name": ""
        }
      },
      "expect": {
        "valid": true
      }
    },
    {
      "name": "empty",
      "input": {
        "document": {
          "name": ""
        }
      },
      "expect": {
        "valid": false,
        "code": "schema_violation",
        "paths": [
          "/name"
        ]
      }
    },
    {
      "name": "over the wire bound",
      "input": {
        "document": {
          "name": ""
        }
      },
      "expect": {
        "valid": false,
        "code": "schema_violation",
        "paths": [
          "/name"
        ]
      }
    },
    {
      "name": "not a string",
      "input": {
        "document": {
          "name": 7
        }
      },
      "expect": {
        "valid": false,
        "code": "schema_violation",
        "paths": [
          "/name"
        ]
      }
    },
    {
      "name": "null",
      "input": {
        "document": {
          "name": null
        }
      },
      "expect": {
        "valid": false,
        "code": "schema_violation",
        "paths": [
          "/name"
        ]
      }
    },
    {
      "name": "missing name",
      "input": {
        "document": {}
      },
      "expect": {
        "valid": false,
        "code": "schema_violation",
        "paths": [
          ""
        ]
      }
    },
    {
      "name": "unknown key",
      "input": {
        "document": {
          "name": "Pilot",
          "email": "x@example.test"
        }
      },
      "expect": {
        "valid": false,
        "code": "schema_violation",
        "paths": [
          ""
        ]
      }
    },
    {
      "name": "role smuggling",
      "input": {
        "document": {
          "name": "Pilot",
          "roles": [
            "staff"
          ]
        }
      },
      "expect": {
        "valid": false,
        "code": "schema_violation",
        "paths": [
          ""
        ]
      }
    },
    {
      "name": "identity smuggling",
      "input": {
        "document": {
          "name": "Pilot",
          "id": "Xk9pQ2rT7vW1yZ4bN6mC8dF3hJ5kL0sA"
        }
      },
      "expect": {
        "valid": false,
        "code": "schema_violation",
        "paths": [
          ""
        ]
      }
    },
    {
      "name": "array body",
      "input": {
        "document": [
          {
            "name": "Pilot"
          }
        ]
      },
      "expect": {
        "valid": false,
        "code": "schema_violation",
        "paths": [
          ""
        ]
      }
    }
  ]
}
