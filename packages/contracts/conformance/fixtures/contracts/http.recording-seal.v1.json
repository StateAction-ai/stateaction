{
  "contract": "http.recording-seal.v1",
  "cases": [
    {
      "name": "two-file inventory with 100 GiB source",
      "input": {
        "document": {
          "files": [
            {
              "fileId": "7c2d3e4f-5061-4728-9bac-1d2e3f4a5b6c",
              "role": "source_mcap",
              "sizeBytes": "107374182400",
              "sha256": "d3690131c737f212505f230d86ea322e788db598fd0162f5500f7e22ab7005bc",
              "required": true
            },
            {
              "fileId": "8d3e4f50-6172-4839-acbd-2e3f4a5b6c7d",
              "role": "recorder_metadata",
              "sizeBytes": "4096",
              "sha256": "ea3bd73e2b506e00527232b3ed743c066da83a8e3066f62a71e75eb9b4aa1db6",
              "required": true
            }
          ]
        }
      },
      "expect": {
        "valid": true
      }
    },
    {
      "name": "byte size over 100 GiB cap",
      "input": {
        "document": {
          "files": [
            {
              "fileId": "7c2d3e4f-5061-4728-9bac-1d2e3f4a5b6c",
              "role": "source_mcap",
              "sizeBytes": "107374182401",
              "sha256": "d3690131c737f212505f230d86ea322e788db598fd0162f5500f7e22ab7005bc",
              "required": true
            },
            {
              "fileId": "8d3e4f50-6172-4839-acbd-2e3f4a5b6c7d",
              "role": "recorder_metadata",
              "sizeBytes": "4096",
              "sha256": "ea3bd73e2b506e00527232b3ed743c066da83a8e3066f62a71e75eb9b4aa1db6",
              "required": true
            }
          ]
        }
      },
      "expect": {
        "valid": false,
        "code": "schema_violation",
        "paths": [
          "/files/0/sizeBytes"
        ]
      }
    },
    {
      "name": "byte size must be a decimal string, not a number",
      "input": {
        "document": {
          "files": [
            {
              "fileId": "7c2d3e4f-5061-4728-9bac-1d2e3f4a5b6c",
              "role": "source_mcap",
              "sizeBytes": 4096,
              "sha256": "d3690131c737f212505f230d86ea322e788db598fd0162f5500f7e22ab7005bc",
              "required": true
            },
            {
              "fileId": "8d3e4f50-6172-4839-acbd-2e3f4a5b6c7d",
              "role": "recorder_metadata",
              "sizeBytes": "4096",
              "sha256": "ea3bd73e2b506e00527232b3ed743c066da83a8e3066f62a71e75eb9b4aa1db6",
              "required": true
            }
          ]
        }
      },
      "expect": {
        "valid": false,
        "code": "schema_violation",
        "paths": [
          "/files/0/sizeBytes"
        ]
      }
    },
    {
      "name": "zero-byte file rejected",
      "input": {
        "document": {
          "files": [
            {
              "fileId": "7c2d3e4f-5061-4728-9bac-1d2e3f4a5b6c",
              "role": "source_mcap",
              "sizeBytes": "107374182400",
              "sha256": "d3690131c737f212505f230d86ea322e788db598fd0162f5500f7e22ab7005bc",
              "required": true
            },
            {
              "fileId": "8d3e4f50-6172-4839-acbd-2e3f4a5b6c7d",
              "role": "recorder_metadata",
              "sizeBytes": "0",
              "sha256": "ea3bd73e2b506e00527232b3ed743c066da83a8e3066f62a71e75eb9b4aa1db6",
              "required": true
            }
          ]
        }
      },
      "expect": {
        "valid": false,
        "code": "schema_violation",
        "paths": [
          "/files/1/sizeBytes"
        ]
      }
    },
    {
      "name": "leading zero rejected",
      "input": {
        "document": {
          "files": [
            {
              "fileId": "7c2d3e4f-5061-4728-9bac-1d2e3f4a5b6c",
              "role": "source_mcap",
              "sizeBytes": "107374182400",
              "sha256": "d3690131c737f212505f230d86ea322e788db598fd0162f5500f7e22ab7005bc",
              "required": true
            },
            {
              "fileId": "8d3e4f50-6172-4839-acbd-2e3f4a5b6c7d",
              "role": "recorder_metadata",
              "sizeBytes": "04096",
              "sha256": "ea3bd73e2b506e00527232b3ed743c066da83a8e3066f62a71e75eb9b4aa1db6",
              "required": true
            }
          ]
        }
      },
      "expect": {
        "valid": false,
        "code": "schema_violation",
        "paths": [
          "/files/1/sizeBytes"
        ]
      }
    },
    {
      "name": "uppercase digest rejected",
      "input": {
        "document": {
          "files": [
            {
              "fileId": "7c2d3e4f-5061-4728-9bac-1d2e3f4a5b6c",
              "role": "source_mcap",
              "sizeBytes": "107374182400",
              "sha256": "D3690131C737F212505F230D86EA322E788DB598FD0162F5500F7E22AB7005BC",
              "required": true
            },
            {
              "fileId": "8d3e4f50-6172-4839-acbd-2e3f4a5b6c7d",
              "role": "recorder_metadata",
              "sizeBytes": "4096",
              "sha256": "ea3bd73e2b506e00527232b3ed743c066da83a8e3066f62a71e75eb9b4aa1db6",
              "required": true
            }
          ]
        }
      },
      "expect": {
        "valid": false,
        "code": "schema_violation",
        "paths": [
          "/files/0/sha256"
        ]
      }
    },
    {
      "name": "duplicate file id",
      "input": {
        "document": {
          "files": [
            {
              "fileId": "7c2d3e4f-5061-4728-9bac-1d2e3f4a5b6c",
              "role": "source_mcap",
              "sizeBytes": "107374182400",
              "sha256": "d3690131c737f212505f230d86ea322e788db598fd0162f5500f7e22ab7005bc",
              "required": true
            },
            {
              "fileId": "7c2d3e4f-5061-4728-9bac-1d2e3f4a5b6c",
              "role": "recorder_metadata",
              "sizeBytes": "4096",
              "sha256": "ea3bd73e2b506e00527232b3ed743c066da83a8e3066f62a71e75eb9b4aa1db6",
              "required": true
            }
          ]
        }
      },
      "expect": {
        "valid": false,
        "code": "duplicate_identity",
        "paths": [
          "/files/1/fileId"
        ]
      }
    },
    {
      "name": "more than 2000 files",
      "input": {
        "repeat": {
          "document": {
            "files": [
              {
                "fileId": "7c2d3e4f-5061-4728-9bac-1d2e3f4a5b6c",
                "role": "source_mcap",
                "sizeBytes": "107374182400",
                "sha256": "d3690131c737f212505f230d86ea322e788db598fd0162f5500f7e22ab7005bc",
                "required": true
              },
              {
                "fileId": "8d3e4f50-6172-4839-acbd-2e3f4a5b6c7d",
                "role": "recorder_metadata",
                "sizeBytes": "4096",
                "sha256": "ea3bd73e2b506e00527232b3ed743c066da83a8e3066f62a71e75eb9b4aa1db6",
                "required": true
              }
            ]
          },
          "pointer": "/files",
          "count": 2001
        }
      },
      "expect": {
        "valid": false,
        "code": "schema_violation",
        "paths": [
          "/files"
        ]
      }
    },
    {
      "name": "empty inventory",
      "input": {
        "document": {
          "files": []
        }
      },
      "expect": {
        "valid": false,
        "code": "schema_violation",
        "paths": [
          "/files"
        ]
      }
    }
  ]
}
