{
  "contract": "http.simulation-provenance.v1",
  "cases": [
    {
      "name": "explicit unknown and known provenance",
      "input": {
        "document": {
          "schema": "stateaction.simulation_provenance.v1",
          "qualification": "simulation_only",
          "mappedTimelineSemantics": "simulation_transport_only",
          "productionQualified": false,
          "provenance": {
            "camera": {
              "status": "known",
              "label": "android-emulator-virtualscene"
            },
            "encoder": {
              "status": "unknown"
            },
            "clock": {
              "status": "known",
              "label": "host-receipt-transport-only"
            }
          }
        }
      },
      "expect": {
        "valid": true
      }
    },
    {
      "name": "every component unknown",
      "input": {
        "document": {
          "schema": "stateaction.simulation_provenance.v1",
          "qualification": "simulation_only",
          "mappedTimelineSemantics": "simulation_transport_only",
          "productionQualified": false,
          "provenance": {
            "camera": {
              "status": "unknown"
            },
            "encoder": {
              "status": "unknown"
            },
            "clock": {
              "status": "unknown"
            }
          }
        }
      },
      "expect": {
        "valid": true
      }
    },
    {
      "name": "cannot claim production qualification",
      "input": {
        "document": {
          "schema": "stateaction.simulation_provenance.v1",
          "qualification": "simulation_only",
          "mappedTimelineSemantics": "simulation_transport_only",
          "productionQualified": true,
          "provenance": {
            "camera": {
              "status": "known",
              "label": "android-emulator-virtualscene"
            },
            "encoder": {
              "status": "unknown"
            },
            "clock": {
              "status": "known",
              "label": "host-receipt-transport-only"
            }
          }
        }
      },
      "expect": {
        "valid": false,
        "code": "schema_violation",
        "paths": [
          "/productionQualified"
        ]
      }
    },
    {
