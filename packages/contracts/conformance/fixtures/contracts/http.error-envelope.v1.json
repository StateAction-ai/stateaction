{
  "contract": "http.error-envelope.v1",
  "cases": [
    {
      "name": "idempotency conflict",
      "input": {
        "document": {
          "error": {
            "code": "idempotency_conflict",
            "message": "Request differs from the original for this idempotency key.",
            "retryable": false
          },
          "requestId": "519f19f0-1f9c-49f1-bf88-7343fd2dc358"
        }
      },
      "expect": {
        "valid": true
      }
    },
    {
      "name": "unknown error code",
      "input": {
        "document": {
          "error": {
            "code": "teapot",
            "message": "Request differs from the original for this idempotency key.",
            "retryable": false
          },
          "requestId": "519f19f0-1f9c-49f1-bf88-7343fd2dc358"
        }
      },
      "expect": {
        "valid": false,
        "code": "schema_violation",
        "paths": [
          "/error/code"
        ]
      }
    },
    {
      "name": "missing retryable",
      "input": {
        "document": {
          "error": {
            "code": "idempotency_conflict",
            "message": "Request differs from the original for this idempotency key."
          },
          "requestId": "519f19f0-1f9c-49f1-bf88-7343fd2dc358"
        }
      },
      "expect": {
        "valid": false,
        "code": "schema_violation",
        "paths": [
          "/error"
        ]
      }
    },
    {
      "name": "provider details leak field",
      "input": {
        "document": {
          "error": {
            "code": "idempotency_conflict",
            "message": "Request differs from the original for this idempotency key.",
            "retryable": false,
            "stack": "at ..."
          },
          "requestId": "519f19f0-1f9c-49f1-bf88-7343fd2dc358"
        }
      },
      "expect": {
        "valid": false,
        "code": "schema_violation",
        "paths": [
          "/error"
        ]
      }
    }
  ]
}
