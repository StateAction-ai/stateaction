      "input": {
        "document": {
          "schemaVersion": 1,
          "jobId": "019a4b2c-3d4e-7f50-8a6b-7c8d9e0f1a2b",
          "outcome": "succeeded",
          "fileCount": 7,
          "clipCount": 1,
