          "inventorySha256": "abababababababababababababababababababababababababababababababab",
          "closedAt": "2026-11-02T14:00:00.123456Z"
        }
      },
      "expect": {
        "valid": false,
        "code": "schema_violation",
        "paths": [
          "/fileCount"
        ]
      }
    },
    {
