      "input": {
        "document": {
          "schemaVersion": 1,
          "jobId": "019a4b2c-3d4e-7f50-8a6b-7c8d9e0f1a2b",
          "outcome": "succeeded",
          "fileCount": 7,
          "clipCount": 1,
          "totalBytes": "123456",
          "manifestFileId": "7c2d3e4f-5061-4728-9bac-1d2e3f4a5b6c",
          "inventorySha256": "abababababababababababababababababababababababababababababababab",
          "closedAt": "2026-11-02T14:00:00.123456Z"
        }
      },
      "expect": {
        "valid": true
      }
    },
    {
