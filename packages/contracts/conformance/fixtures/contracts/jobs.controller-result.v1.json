      "input": {
        "document": {
          "state": "recorded",
          "bootstrapToken": "sa_svc_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "startDeadline": "2026-11-02T08:00:00Z",
