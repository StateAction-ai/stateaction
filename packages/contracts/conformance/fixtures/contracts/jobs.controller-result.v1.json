    {
      "name": "workflow run or execution recorded",
      "input": {
        "document": {
          "recorded": true
        }
      },
      "expect": {
        "valid": true
      }
    },
    {
      "name": "replayed record is not an error",
      "input": {
        "document": {
          "recorded": false
        }
      },
      "expect": {
        "valid": true
      }
    },
    {
      "name": "lease granted",
      "input": {
        "document": {
          "granted": true,
          "expiresAt": "2026-11-02T14:00:00.123Z"
        }
      },
      "expect": {
        "valid": true
      }
    },
    {
      "name": "lease refused: live owner",
      "input": {
        "document": {
          "granted": false,
          "reason": "live_owner"
        }
      },
      "expect": {
        "valid": true
      }
    },
    {
      "name": "lease refused: different run",
      "input": {
        "document": {
          "granted": false,
          "reason": "different_run"
        }
      },
      "expect": {
        "valid": true
