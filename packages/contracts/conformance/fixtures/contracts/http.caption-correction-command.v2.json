{
  "contract": "http.caption-correction-command.v2",
  "cases": [
    {
      "name": "edit",
      "input": {
        "document": {
          "jobId": "019a4b2c-3d4e-7f50-8a6b-7c8d9e0f1a2b",
          "resultManifestSha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "selectionRevision": 1,
          "correctionId": "00000000-0000-4000-8000-000000000001",
          "segmentsSha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "expectedRevision": 1,
          "expectedMarkRevision": 2,
          "action": "edit",
          "text": "lift the cup"
        }
      },
      "expect": {
        "valid": true
      }
    },
    {
      "name": "omit caption",
      "input": {
        "document": {
          "jobId": "019a4b2c-3d4e-7f50-8a6b-7c8d9e0f1a2b",
          "resultManifestSha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "selectionRevision": 1,
          "correctionId": "00000000-0000-4000-8000-000000000001",
          "segmentsSha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "expectedRevision": 1,
          "expectedMarkRevision": 2,
          "action": "omit"
        }
      },
      "expect": {
        "valid": true
      }
    },
    {
      "name": "undo last edit",
      "input": {
        "document": {
          "jobId": "019a4b2c-3d4e-7f50-8a6b-7c8d9e0f1a2b",
          "resultManifestSha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "selectionRevision": 1,
          "correctionId": "00000000-0000-4000-8000-000000000001",
          "segmentsSha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "expectedRevision": 1,
          "expectedMarkRevision": 2,
          "action": "undo"
        }
      },
      "expect": {
        "valid": true
      }
    },
    {
      "name": "reject empty edit",
      "input": {
        "document": {
          "jobId": "019a4b2c-3d4e-7f50-8a6b-7c8d9e0f1a2b",
          "resultManifestSha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "selectionRevision": 1,
          "correctionId": "00000000-0000-4000-8000-000000000001",
          "segmentsSha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "expectedRevision": 1,
          "expectedMarkRevision": 2,
          "action": "edit",
          "text": ""
        }
      },
      "expect": {
        "valid": false,
        "code": "schema_violation"
      }
    },
    {
      "name": "omit is distinct from an edit",
      "input": {
        "document": {
          "jobId": "019a4b2c-3d4e-7f50-8a6b-7c8d9e0f1a2b",
          "resultManifestSha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "selectionRevision": 1,
          "correctionId": "00000000-0000-4000-8000-000000000001",
          "segmentsSha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "expectedRevision": 1,
          "expectedMarkRevision": 2,
          "action": "omit",
          "text": "ignored"
        }
      },
      "expect": {
        "valid": false,
        "code": "schema_violation"
      }
    }
  ]
}
