{
  "contract": "jobs.output-close.v1",
  "cases": [
    {
      "name": "succeeded",
      "input": {
        "document": {
          "schemaVersion": 1,
          "jobId": "019a4b2c-3d4e-7f50-8a6b-7c8d9e0f1a2b",
          "invocationNonce": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "outcome": "succeeded"
        }
      },
      "expect": {
        "valid": true
      }
    },
    {
      "name": "failed run seals its diagnostics",
      "input": {
        "document": {
          "schemaVersion": 1,
          "jobId": "019a4b2c-3d4e-7f50-8a6b-7c8d9e0f1a2b",
          "invocationNonce": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "outcome": "failed"
        }
      },
      "expect": {
        "valid": true
      }
    },
    {
      "name": "outcome is closed",
      "input": {
        "document": {
          "schemaVersion": 1,
          "jobId": "019a4b2c-3d4e-7f50-8a6b-7c8d9e0f1a2b",
          "invocationNonce": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "outcome": "partial"
        }
      },
      "expect": {
        "valid": false,
        "code": "schema_violation",
        "paths": [
          "/outcome"
        ]
      }
    },
    {
      "name": "nonce is required",
      "input": {
        "document": {
          "schemaVersion": 1,
          "jobId": "019a4b2c-3d4e-7f50-8a6b-7c8d9e0f1a2b",
          "outcome": "succeeded"
        }
      },
      "expect": {
        "valid": false,
        "code": "schema_violation",
        "paths": [
          ""
        ]
      }
    },
    {
      "name": "nonce is 32 bytes base64url",
      "input": {
        "document": {
          "schemaVersion": 1,
          "jobId": "019a4b2c-3d4e-7f50-8a6b-7c8d9e0f1a2b",
          "invocationNonce": "x",
          "outcome": "succeeded"
        }
      },
      "expect": {
        "valid": false,
        "code": "schema_violation",
        "paths": [
          "/invocationNonce"
        ]
      }
    },
    {
      "name": "no file list is accepted",
      "input": {
        "document": {
          "schemaVersion": 1,
          "jobId": "019a4b2c-3d4e-7f50-8a6b-7c8d9e0f1a2b",
          "invocationNonce": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "outcome": "succeeded",
          "files": []
        }
      },
      "expect": {
        "valid": false,
        "code": "schema_violation",
        "paths": [
          ""
        ]
      }
    },
    {
      "name": "closed object",
      "input": {
        "document": {
          "schemaVersion": 1,
          "jobId": "019a4b2c-3d4e-7f50-8a6b-7c8d9e0f1a2b",
          "invocationNonce": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "outcome": "succeeded",
          "admin": true
        }
      },
      "expect": {
        "valid": false,
        "code": "schema_violation",
        "paths": [
          ""
        ]
      }
    }
  ]
}
