{
  "contract": "artifacts.cached-originating-recipe.v1",
  "cases": [
    {
      "name": "pinned originating recipe",
      "input": {
        "document": {
          "kind": "recipe",
          "recipe_id": "indego_hosted_canary@1",
          "recipe_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      },
      "expect": {
        "valid": true
      }
