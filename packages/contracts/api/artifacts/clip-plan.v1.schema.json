{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateaction.ai/schemas/artifacts/clip-plan.v1.json",
  "title": "Clip plan v1",
  "description": "An ordered partition of decoded frame ordinals. Span ends are exclusive; the source IDs and native timestamps identify the first and last included frames.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "recording_id",
    "plan_version",
    "source_manifest_sha256",
    "frame_count",
    "origin_ts_ns",
    "clock_domain",
    "mode",
    "state",
    "error_code",
    "filter_version",
    "params_sha256",
    "producer",
    "spans"
  ],
  "properties": {
    "schema": {
      "const": "stateaction.clip-plan.v1"
    },
    "recording_id": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/uuid"
    },
    "plan_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
    },
    "source_manifest_sha256": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/sha256"
    },
    "frame_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
    },
    "origin_ts_ns": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/timestampNs"
    },
    "clock_domain": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/clockDomain"
    },
    "mode": {
      "enum": ["passthrough", "shadow", "apply"]
    },
    "state": {
      "enum": ["succeeded", "failed"]
    },
    "error_code": {
      "anyOf": [
        {
          "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/revision"
        },
        {
          "type": "null"
        }
      ]
    },
    "filter_version": {
      "type": "string",
      "pattern": "^clip_filter@(0|[1-9][0-9]{0,8})$"
    },
    "params_sha256": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/sha256"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_id", "revision", "weights_sha256", "gpu_type"],
      "properties": {
        "module_id": {
          "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/revision"
        },
        "revision": {
          "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/revision"
        },
        "weights_sha256": {
          "anyOf": [
            {
              "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "gpu_type": {
          "anyOf": [
            {
              "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/revision"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "spans": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/clip"
          },
          {
            "$ref": "#/$defs/exclusion"
          }
        ]
      }
    }
  },
  "if": {
    "properties": {
      "state": {
        "const": "failed"
      }
    },
    "required": ["state"]
  },
  "then": {
    "properties": {
      "error_code": {
        "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/revision"
      }
    }
  },
  "else": {
    "properties": {
      "error_code": {
        "type": "null"
      }
    }
  },
  "$defs": {
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "start_ordinal",
        "end_ordinal",
        "first_source_frame_id",
        "last_source_frame_id",
        "start_ts_ns",
        "end_ts_ns"
      ],
      "properties": {
        "kind": {
          "const": "clip"
        },
        "start_ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "end_ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "first_source_frame_id": {
          "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/int64Decimal"
        },
        "last_source_frame_id": {
          "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/int64Decimal"
        },
        "start_ts_ns": {
          "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/timestampNs"
        },
        "end_ts_ns": {
          "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/timestampNs"
        }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "start_ordinal",
        "end_ordinal",
        "first_source_frame_id",
        "last_source_frame_id",
        "start_ts_ns",
        "end_ts_ns",
        "reason",
        "signals",
        "thresholds",
        "filter_version"
      ],
      "properties": {
        "kind": {
          "const": "excluded"
        },
        "start_ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "end_ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "first_source_frame_id": {
          "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/int64Decimal"
        },
        "last_source_frame_id": {
          "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/int64Decimal"
        },
        "start_ts_ns": {
          "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/timestampNs"
        },
        "end_ts_ns": {
          "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/timestampNs"
        },
        "reason": {
          "enum": ["walking", "idle", "no_hand", "talking", "judge_no_action"]
        },
        "signals": {
          "$ref": "#/$defs/evidence"
        },
        "thresholds": {
          "$ref": "#/$defs/evidence"
        },
        "filter_version": {
          "type": "string",
          "pattern": "^clip_filter@(0|[1-9][0-9]{0,8})$"
        }
      }
    },
    "evidence": {
      "description": "Flat bounded parameter map. Its sa-cjson-v1 digest is params_sha256.",
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "https://stateaction.ai/schemas/common.v2.json#/$defs/scalar"
      },
      "minProperties": 1
    }
  }
}
