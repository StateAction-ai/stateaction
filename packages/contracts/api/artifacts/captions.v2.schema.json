{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateaction.ai/schemas/artifacts/captions.v2.json",
  "title": "Segment captions v2",
  "description": "Accepted review projection of cached captions results. The original generator files remain separate, unchanged evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "job_id",
    "recording_id",
    "source_manifest_sha256",
    "segments_sha256",
    "producer",
    "rows"
  ],
  "properties": {
    "schema": {
      "const": "stateaction.captions.v2"
    },
    "job_id": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/uuid"
    },
    "recording_id": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/uuid"
    },
    "source_manifest_sha256": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/sha256"
    },
    "segments_sha256": {
      "description": "SHA-256 of the exact segments_json bytes that were captioned.",
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/sha256"
    },
    "producer": {
      "$ref": "https://stateaction.ai/schemas/common.v3.json#/$defs/producer"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment_id", "status", "error_code"],
        "properties": {
          "segment_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "status": {
            "type": "string",
            "enum": ["complete", "failed", "not_captioned"]
          },
          "error_code": {
            "description": "null exactly when status is complete; otherwise the failure or reason code (for example unsupported_target_frames, segment_failed_window).",
            "$ref": "https://stateaction.ai/schemas/common.v2.json#/$defs/nullableErrorCode"
          },
          "text": {
            "description": "Model caption, verbatim: one line, no leading or trailing whitespace, never empty.",
            "type": "string",
            "maxLength": 2000,
            "pattern": "^[^\\u0000-\\u0020\\u007f]([^\\u0000-\\u001f\\u007f]*[^\\u0000-\\u0020\\u007f])?$"
          },
          "lang": {
            "description": "Language tag of text.",
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8}){0,3}$"
          },
          "derived": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule", "short_label", "hand", "steps"],
            "properties": {
              "rule": {
                "const": "caption_rule@1"
              },
              "short_label": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[^\\u0000-\\u0020\\u007f]([^\\u0000-\\u001f\\u007f]*[^\\u0000-\\u0020\\u007f])?$"
              },
              "hand": {
                "type": "string",
                "enum": ["left", "right", "both", "none"]
              },
              "steps": {
                "description": "text split on commas, each step trimmed of spaces and tabs, empty steps dropped.",
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 2000,
                  "pattern": "^[^\\u0000-\\u0020\\u007f]([^\\u0000-\\u001f\\u007f]*[^\\u0000-\\u0020\\u007f])?$"
                },
                "minItems": 1,
                "maxItems": 64
              }
            }
          }
        },
        "if": {
          "properties": {
            "status": {
              "const": "complete"
            }
          },
          "required": ["status"]
        },
        "then": {
          "properties": {
            "error_code": {
              "type": "null"
            },
            "text": {},
            "lang": {},
            "derived": {}
          },
          "required": ["text", "lang", "derived"]
        },
        "else": {
          "properties": {
            "error_code": {
              "$ref": "https://stateaction.ai/schemas/common.v2.json#/$defs/errorCode"
            },
            "text": false,
            "lang": false,
            "derived": false
          }
        }
      },
      "minItems": 0,
      "maxItems": 100000
    }
  }
}
