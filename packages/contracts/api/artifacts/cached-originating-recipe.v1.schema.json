{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateaction.ai/schemas/artifacts/cached-originating-recipe.v1.json",
  "title": "Originating recipe reference for a cached import",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "recipe_id", "recipe_sha256"],
  "properties": {
    "kind": {
      "const": "recipe"
    },
    "recipe_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}@[1-9][0-9]{0,8}$"
    },
    "recipe_sha256": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/sha256"
    }
  }
}
