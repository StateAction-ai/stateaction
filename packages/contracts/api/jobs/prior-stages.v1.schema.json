{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateaction.ai/schemas/jobs/prior-stages.v1.json",
  "title": "Prior stages v1",
  "description": "GET /internal/v1/jobs/{jobId}/prior-stages (workflow controller, jobs:status). The recorded runs of a recipe job's stages before the sealing hand_pose stage, each with every completed output file of the job attributed to that stage by its slot (segments.json / captions.json and diagnostics/<stage>/...). The controller passes these rows to the hand_pose stage bootstrap (priorStages) and the caption stage its segments input. An identity and inventory read only; never spawn authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobId", "stages"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "jobId": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/uuid"
    },
    "stages": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "state", "errorCode", "counts", "outputs"],
        "properties": {
          "stage": {
            "type": "string",
            "enum": ["segment", "caption"]
          },
          "state": {
            "$ref": "https://stateaction.ai/schemas/common.v2.json#/$defs/stageRunState"
          },
          "errorCode": {
            "$ref": "https://stateaction.ai/schemas/common.v2.json#/$defs/nullableErrorCode"
          },
          "counts": {
            "$ref": "https://stateaction.ai/schemas/common.v2.json#/$defs/countMap"
          },
          "outputs": {
            "type": "array",
            "minItems": 0,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fileId", "role", "slot", "sizeBytes", "sha256"],
              "properties": {
                "fileId": {
                  "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/uuid"
                },
                "role": {
                  "$ref": "https://stateaction.ai/schemas/common.v2.json#/$defs/outputFileRole"
                },
                "slot": {
                  "type": "string",
                  "pattern": "^(segments\\.json|captions\\.json|diagnostics/(segment|caption)/[A-Za-z0-9._-]{1,128})$"
                },
                "sizeBytes": {
                  "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/fileSizeBytes"
                },
                "sha256": {
                  "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/sha256"
                }
              }
            }
          }
        }
      }
    }
  }
}
