{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateaction.ai/schemas/jobs/graph-control.v1.json",
  "title": "Lease-fenced graph control",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "owner", "nodeId", "bindingSha256"],
      "properties": {
        "action": {
          "const": "issue_node_claim"
        },
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,200}$"
        },
        "nodeId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        },
        "bindingSha256": {
          "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/sha256"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "owner", "nodeId"],
      "properties": {
        "action": {
          "const": "begin_node_submission"
        },
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,200}$"
        },
        "nodeId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "owner", "nodeId", "executionRef"],
      "properties": {
        "action": {
          "const": "record_node_call"
        },
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,200}$"
        },
        "nodeId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        },
        "executionRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "owner",
        "nodeId",
        "executionRef",
        "kind",
        "observed"
      ],
      "properties": {
        "action": {
          "const": "record_node_terminal"
        },
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,200}$"
        },
        "nodeId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        },
        "executionRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "kind": {
          "enum": ["local_child_reaped", "provider_call_terminal"]
        },
        "observed": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": true
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "owner",
        "nodeId",
        "state",
        "errorCode",
        "receipt",
        "files"
      ],
      "properties": {
        "action": {
          "const": "record_node_result"
        },
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,200}$"
        },
        "nodeId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        },
        "state": {
          "enum": ["succeeded", "failed", "cancelled", "skipped"]
        },
        "errorCode": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          ]
        },
        "receipt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 524288
            }
          ]
        },
        "files": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["port", "logicalFile", "name", "fileId"],
            "properties": {
              "port": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "logicalFile": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,128}$"
              },
              "fileId": {
                "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/uuid"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "owner"],
      "properties": {
        "action": {
          "enum": ["seal_graph", "prepare_graph"]
        },
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,200}$"
        }
      }
    }
  ]
}
