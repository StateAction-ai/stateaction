{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateaction.ai/schemas/jobs/recipe.v2.json",
  "title": "Clip processing recipe v2",
  "description": "V1 stage recipe with the CPU clip filter configuration. The only registered implementation is the whole-recording passthrough planner. Cutting requires a future recipe contract with certified configurations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recipeId",
    "maxJobCostUsd",
    "stages",
    "clipFilter"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "recipeId": {
      "$ref": "https://stateaction.ai/schemas/common.v2.json#/$defs/recipeRef"
    },
    "maxJobCostUsd": {
      "description": "Hard cap on the estimated GPU and CPU cost of one job, in US dollars.",
      "$ref": "https://stateaction.ai/schemas/common.v2.json#/$defs/usdAmount"
    },
    "stages": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/segmentStage"
        },
        {
          "$ref": "#/$defs/captionStage"
        },
        {
          "$ref": "#/$defs/handPoseStage"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "clipFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "module", "params"],
      "properties": {
        "mode": {
          "const": "passthrough"
        },
        "module": {
          "const": "clip_filter@0"
        },
        "params": {
          "type": "object",
          "additionalProperties": false
        }
      }
    }
  },
  "$defs": {
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu", "budgetSeconds", "maxContainers", "retries"],
      "properties": {
        "gpu": {
          "$ref": "https://stateaction.ai/schemas/common.v2.json#/$defs/gpuType"
        },
        "budgetSeconds": {
          "description": "Wall-clock budget of the stage; the executor timeout.",
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "maxContainers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "retries": {
          "const": 0
        }
      }
    },
    "segmentStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "enabled", "module", "params", "resources"],
      "properties": {
        "stage": {
          "const": "segment"
        },
        "enabled": {
          "type": "boolean"
        },
        "module": {
          "$ref": "https://stateaction.ai/schemas/common.v2.json#/$defs/moduleRef"
        },
        "params": {
          "$ref": "https://stateaction.ai/schemas/common.v2.json#/$defs/paramMap"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    },
    "captionStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "enabled", "module", "params", "resources"],
      "properties": {
        "stage": {
          "const": "caption"
        },
        "enabled": {
          "type": "boolean"
        },
        "module": {
          "$ref": "https://stateaction.ai/schemas/common.v2.json#/$defs/moduleRef"
        },
        "params": {
          "$ref": "https://stateaction.ai/schemas/common.v2.json#/$defs/paramMap"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    },
    "handPoseStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "enabled", "module", "params", "resources"],
      "properties": {
        "stage": {
          "const": "hand_pose"
        },
        "enabled": {
          "const": true
        },
        "module": {
          "$ref": "https://stateaction.ai/schemas/common.v2.json#/$defs/moduleRef"
        },
        "params": {
          "$ref": "https://stateaction.ai/schemas/common.v2.json#/$defs/paramMap"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    }
  }
}
