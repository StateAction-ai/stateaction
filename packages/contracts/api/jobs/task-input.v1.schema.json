{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateaction.ai/schemas/jobs/task-input.v1.json",
  "title": "Compute task input v1",
  "description": "Single positional compute argument. Secret-free references only; the bootstrap capability travels separately (stdin/private file locally, private invocation on Modal).",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "jobId",
        "targetId",
        "profileRevision",
        "kind",
        "sourceManifestSha256"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "jobId": {
          "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/uuid"
        },
        "targetId": {
          "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/uuid"
        },
        "profileRevision": {
          "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/revision"
        },
        "kind": {
          "const": "process_recording"
        },
        "sourceManifestSha256": {
          "description": "SHA-256 of the exact sealed source_manifest file bytes (recording-source/v1).",
          "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/sha256"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "jobId",
        "targetId",
        "profileRevision",
        "kind",
        "selectionSha256"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "jobId": {
          "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/uuid"
        },
        "targetId": {
          "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/uuid"
        },
        "profileRevision": {
          "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/revision"
        },
        "kind": {
          "const": "export_release"
        },
        "selectionSha256": {
          "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/sha256"
        }
      }
    }
  ]
}
