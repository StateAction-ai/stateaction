{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateaction.ai/schemas/http/capture-recipe-select.v1.json",
  "title": "Select a processing recipe for a held recording",
  "type": "object",
  "additionalProperties": false,
  "required": ["recipeId", "sourceManifestSha256"],
  "properties": {
    "recipeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}@[1-9][0-9]{0,8}$"
    },
    "sourceManifestSha256": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/sha256"
    }
  }
}
