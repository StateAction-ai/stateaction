{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateaction.ai/schemas/http/graph-retry-command.v1.json",
  "title": "Graph retry command",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "expectedPlanSha256", "reason"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "clipId": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/uuid"
    },
    "parentJobId": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/uuid"
    },
    "nodes": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
      }
    },
    "requestId": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/uuid"
    },
    "expectedPlanSha256": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/sha256"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "scope": {
      "const": "failed_clips"
    }
  },
  "if": {
    "required": ["scope"],
    "properties": {
      "scope": {}
    }
  },
  "then": {
    "not": {
      "anyOf": [
        {
          "required": ["clipId"],
          "properties": {
            "clipId": {}
          }
        },
        {
          "required": ["parentJobId"],
          "properties": {
            "parentJobId": {}
          }
        },
        {
          "required": ["nodes"],
          "properties": {
            "nodes": {}
          }
        }
      ]
    }
  },
  "else": {
    "required": ["clipId", "parentJobId", "nodes"],
    "properties": {
      "clipId": {},
      "parentJobId": {},
      "nodes": {}
    }
  }
}
