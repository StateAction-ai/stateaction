{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateaction.ai/schemas/http/parts-sign.v1.json",
  "title": "Sign upload parts request v1",
  "description": "POST /api/v1/uploads/{fileId}/parts/sign.",
  "type": "object",
  "additionalProperties": false,
  "required": ["expectedTransportEpoch", "partNumbers"],
  "properties": {
    "expectedTransportEpoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "partNumbers": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    }
  }
}
