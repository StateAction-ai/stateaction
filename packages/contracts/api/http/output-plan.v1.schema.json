{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateaction.ai/schemas/http/output-plan.v1.json",
  "title": "Output upload plan response v1",
  "description": "POST /internal/v1/jobs/{jobId}/outputs and GET /internal/v1/jobs/{jobId}/outputs/{fileId} data payload, carried as `data` inside http.success-envelope.v1. Same shape as http.upload-plan.v1 with an output role and no source-manifest rule. partCount must equal ceil(sizeBytes / partSizeBytes).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fileId",
    "recordingId",
    "role",
    "sizeBytes",
    "sha256",
    "transportEpoch",
    "partSizeBytes",
    "partCount",
    "state",
    "transportExpiresAt"
  ],
  "properties": {
    "fileId": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/uuid"
    },
    "recordingId": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/uuid"
    },
    "role": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/outputFileRole"
    },
    "sizeBytes": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/fileSizeBytes"
    },
    "sha256": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/sha256"
    },
    "transportEpoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "partSizeBytes": {
      "const": "67108864"
    },
    "partCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "state": {
      "type": "string",
      "enum": [
        "reserved",
        "uploading",
        "completing",
        "completed",
        "verified",
        "cancelled",
        "failed",
        "expired"
      ]
    },
    "transportExpiresAt": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/rfc3339Utc"
    }
  }
}
