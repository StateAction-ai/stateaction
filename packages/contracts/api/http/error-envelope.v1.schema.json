{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateaction.ai/schemas/http/error-envelope.v1.json",
  "title": "API error envelope v1",
  "description": "Failure body for every /api/v1 and /internal/v1 route. HTTP status mapping is documented in packages/contracts/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["error", "requestId"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "unauthenticated",
            "forbidden",
            "not_found",
            "conflict",
            "idempotency_conflict",
            "payload_too_large",
            "invalid_request",
            "unsupported_version",
            "rate_limited",
            "provider_unavailable",
            "internal"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "requestId": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/uuid"
    }
  }
}
