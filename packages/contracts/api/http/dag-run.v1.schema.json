{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateaction.ai/schemas/http/dag-run.v1.json",
  "title": "Recipe run view v1",
  "description": "Server-rendered view of one job's recipe run (the data of the staff run route), built from the recorded stage runs; it is never an uploaded output file. One node per stage in recipe order. Each node states truthfully what happened: a disabled stage is not_run, failed, cancelled and not_run nodes carry an errorCode, and nothing is shown as succeeded without a recorded receipt (receiptSha256). Cost figures are estimates from recorded container seconds, not billing data. Rule dag_run checks these pairings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "recordingId",
    "jobState",
    "recipeId",
    "recipeSha256",
    "maxJobCostUsd",
    "estimatedCostUsd",
    "stages",
    "renderedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "jobId": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/uuid"
    },
    "recordingId": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/uuid"
    },
    "jobState": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/jobState"
    },
    "recipeId": {
      "$ref": "https://stateaction.ai/schemas/common.v2.json#/$defs/recipeRef"
    },
    "recipeSha256": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/sha256"
    },
    "maxJobCostUsd": {
      "$ref": "https://stateaction.ai/schemas/common.v2.json#/$defs/usdAmount"
    },
    "estimatedCostUsd": {
      "$ref": "https://stateaction.ai/schemas/common.v2.json#/$defs/nullableUsdAmount"
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "minItems": 3,
      "maxItems": 3,
      "description": "One node per stage in recipe order: segment, caption, hand_pose (rule dag_run)."
    },
    "renderedAt": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/rfc3339Utc"
    }
  },
  "$defs": {
    "nullableInstant": {
      "oneOf": [
        {
          "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/rfc3339Utc"
        },
        {
          "type": "null"
        }
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "enabled",
        "module",
        "state",
        "errorCode",
        "callId",
        "gpu",
        "startedAt",
        "finishedAt",
        "counts",
        "estimatedCostUsd",
        "receiptSha256"
      ],
      "properties": {
        "stage": {
          "$ref": "https://stateaction.ai/schemas/common.v2.json#/$defs/stage"
        },
        "enabled": {
          "type": "boolean"
        },
        "module": {
          "$ref": "https://stateaction.ai/schemas/common.v2.json#/$defs/moduleRef"
        },
        "state": {
          "$ref": "https://stateaction.ai/schemas/common.v2.json#/$defs/stageRunState"
        },
        "errorCode": {
          "$ref": "https://stateaction.ai/schemas/common.v2.json#/$defs/nullableErrorCode"
        },
        "callId": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "gpu": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestedType", "observedType"],
          "properties": {
            "requestedType": {
              "$ref": "https://stateaction.ai/schemas/common.v2.json#/$defs/gpuType"
            },
            "observedType": {
              "$ref": "https://stateaction.ai/schemas/common.v2.json#/$defs/observedGpu"
            }
          }
        },
        "startedAt": {
          "$ref": "#/$defs/nullableInstant"
        },
        "finishedAt": {
          "$ref": "#/$defs/nullableInstant"
        },
        "counts": {
          "$ref": "https://stateaction.ai/schemas/common.v2.json#/$defs/countMap"
        },
        "estimatedCostUsd": {
          "$ref": "https://stateaction.ai/schemas/common.v2.json#/$defs/nullableUsdAmount"
        },
        "receiptSha256": {
          "oneOf": [
            {
              "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
