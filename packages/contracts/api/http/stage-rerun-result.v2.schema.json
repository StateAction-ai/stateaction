{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateaction.ai/schemas/http/stage-rerun-result.v2.json",
  "title": "Stage-set rerun result v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobs", "replayed"],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clipId", "parentJobId", "jobId"],
        "properties": {
          "clipId": {
            "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/uuid"
          },
          "parentJobId": {
            "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/uuid"
          },
          "jobId": {
            "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/uuid"
          }
        }
      }
    },
    "replayed": {
      "type": "boolean"
    }
  }
}
