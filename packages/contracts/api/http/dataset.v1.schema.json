{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateaction.ai/schemas/http/dataset.v1.json",
  "title": "Dataset view v1",
  "description": "Data payload of GET /api/v1/datasets/{datasetId}. Customers receive only datasetId, name, clipCount and durationNs; revision and createdAt are staff-only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["datasetId", "name", "clipCount", "durationNs"],
  "properties": {
    "datasetId": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "clipCount": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/safeCount",
      "description": "Distinct currently visible approved members (same visibility rule as the member grid)."
    },
    "durationNs": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/int64Decimal"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "Staff only."
    },
    "createdAt": {
      "$ref": "https://stateaction.ai/schemas/common.v1.json#/$defs/rfc3339Utc",
      "description": "Staff only."
    }
  }
}
