{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateaction.ai/schemas/common.v1.json",
  "title": "StateAction shared definitions v1",
  "$defs": {
    "uuid": {
      "description": "Domain entity identifier: canonical lowercase RFC 9562 UUID, versions 1-8.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "authUserId": {
      "description": "Opaque identity-provider user ID. Never parsed; never assumed to be a UUID.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~:-]{0,127}$"
    },
    "sha256": {
      "description": "SHA-256 digest as 64 lowercase hex characters.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "int64Decimal": {
      "description": "Exact non-negative signed 64-bit integer as a decimal string (0..9223372036854775807); used for nanosecond timestamps, PTS and native counters.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$"
    },
    "timestampNs": {
      "description": "Integer nanoseconds in one named clock domain, as an exact decimal string. Never a float; never compared across clock domains.",
      "$ref": "#/$defs/int64Decimal"
    },
    "fileSizeBytes": {
      "description": "Exact file size in bytes as a decimal string, 1..107374182400 (100 GiB transport cap).",
      "type": "string",
      "pattern": "^([1-9][0-9]{0,10}|10[0-6][0-9]{9}|107[0-2][0-9]{8}|1073[0-6][0-9]{7}|10737[0-3][0-9]{6}|1073740[0-9]{5}|1073741[0-7][0-9]{4}|10737418[0-1][0-9]{3}|107374182[0-3][0-9]{2}|107374182400)$"
    },
    "byteCount": {
      "description": "Exact byte count or offset as a decimal string, 0..107374182400.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,10}|10[0-6][0-9]{9}|107[0-2][0-9]{8}|1073[0-6][0-9]{7}|10737[0-3][0-9]{6}|1073740[0-9]{5}|1073741[0-7][0-9]{4}|10737418[0-1][0-9]{3}|107374182[0-3][0-9]{2}|107374182400)$"
    },
    "safeCount": {
      "description": "Bounded JSON integer count within the IEEE-754 safe range.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rfc3339Utc": {
      "description": "Wall-clock time, RFC 3339 UTC with Z suffix and up to nanosecond fraction.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
    },
    "clockDomain": {
      "description": "Named native clock domain (for example android.elapsed_realtime or android.sensor_event). Timestamps from different domains are never merged.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}(\\.[a-z][a-z0-9_]{0,31}){0,3}$"
    },
    "revision": {
      "description": "Code, profile or rule revision label.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
    },
    "safeRelativePath": {
      "description": "Relative POSIX path without empty, dot or dot-dot segments.",
      "type": "string",
      "maxLength": 255,
      "pattern": "^(?!.*(^|/)\\.{1,2}(/|$))[A-Za-z0-9._-]{1,128}(/[A-Za-z0-9._-]{1,128}){0,7}$"
    },
    "sourceFileRole": {
      "type": "string",
      "enum": ["source_mcap", "recorder_metadata", "calibration"]
    },
    "outputFileRole": {
      "type": "string",
      "enum": [
        "result_manifest",
        "clip_mp4",
        "hand_arrays_npz",
        "hand_observations_json",
        "frame_map_json",
        "thumbnail_jpeg",
        "viewer_rrd"
      ]
    },
    "jobKind": {
      "type": "string",
      "enum": ["process_recording", "export_release"]
    },
    "jobState": {
      "type": "string",
      "enum": [
        "queued",
        "submitting",
        "submit_unknown",
        "running",
        "result_pending",
        "succeeded",
        "failed",
        "cancel_requested",
        "cancelled",
        "needs_attention"
      ]
    },
    "raster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        }
      }
    },
    "timeBase": {
      "description": "Rational time base: one PTS tick equals num/den seconds.",
      "type": "object",
      "additionalProperties": false,
      "required": ["num", "den"],
      "properties": {
        "num": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "den": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    }
  }
}
