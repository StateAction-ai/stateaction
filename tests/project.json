{
  "name": "root-python",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "root": "tests",
  "projectType": "library",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "!{projectRoot}/**/__pycache__/**/*",
        "{workspaceRoot}/scripts/*.py",
        "{workspaceRoot}/requirements-stera.txt",
        "{workspaceRoot}/stera-sdk",
        "{workspaceRoot}/stera-sdk/**/*",
        "pythonToolchain",
        {
          "runtime": "git ls-files -s stera-sdk | sha256sum"
        },
        "externalDeps"
      ],
      "options": {
        "command": "uv run --no-project --python 3.11 --with-requirements requirements-stera.txt python -m unittest discover -s tests -p 'test_*.py' -v"
      }
    }
  }
}
