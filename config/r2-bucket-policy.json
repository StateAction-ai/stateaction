{
  "schema": "stateaction.r2-bucket-policy.v1",
  "buckets": {
    "stateaction-prod": { "origins": ["https://stateaction-web.onrender.com"] },
    "stateaction-stage": {
      "origins": ["http://127.0.0.1:24178"],
      "cors": {
        "id": "sa78-stage-playback",
        "methods": ["GET"],
        "headers": ["range", "if-match"],
        "expose": ["ETag", "Content-Range"],
        "maxAgeSeconds": 60
      }
    }
  },
  "cors": {
    "methods": ["GET", "HEAD", "PUT"],
    "headers": ["content-type", "range", "x-amz-*"],
    "expose": ["ETag", "Content-Length", "Content-Range", "Accept-Ranges"],
    "maxAgeSeconds": 600
  },
  "lifecycle": { "abortIncompleteMultipartDays": 7 },
  "public": "never: managed r2.dev domain disabled and no custom domain on every bucket"
}
