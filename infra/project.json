{
  "name": "infra",
  "root": "infra",
  "projectType": "application",
  "implicitDependencies": ["web", "controller-python", "processing"],
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec prettier --check \"infra/**/*.{json,yaml,md,mjs}\" render.yaml config/render-deploy.json config/r2-bucket-policy.json .github/workflows/deploy.yml docs/components/render-deployment.md"
      },
      "inputs": [
        "default",
        "{workspaceRoot}/render.yaml",
        "{workspaceRoot}/.github/workflows/deploy.yml",
        "{workspaceRoot}/docs/components/render-deployment.md",
        "{workspaceRoot}/.prettierignore",
        "prettier"
      ]
    },
    "integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "target": "build",
          "projects": ["web", "controller-python", "processing"]
        }
      ],
      "options": {
        "command": "bash scripts/platform/ci-smoke.sh && bash scripts/platform/hosted-smoke.sh"
      },
      "inputs": [
        "default",
        "^fixtureProduction",
        "runtimeTooling",
        "{workspaceRoot}/render.yaml",
        "{workspaceRoot}/scripts/platform/local-fixtures.mjs",
        "!{projectRoot}/**/*.md"
      ],
      "parallelism": false
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test --test-concurrency=2 infra/test/*.test.mjs scripts/platform/render-deploy.test.mjs scripts/platform/deploy-scope.test.mjs"
      },
      "inputs": [
        "default",
        "{workspaceRoot}/render.yaml",
        "{workspaceRoot}/.github/workflows/deploy.yml",
        "{workspaceRoot}/scripts/deploy/render-deploy.sh",
        "{workspaceRoot}/scripts/platform/render-deploy.mjs",
        "{workspaceRoot}/scripts/platform/render-deploy.test.mjs",
        "{workspaceRoot}/scripts/platform/deploy-scope.mjs",
        "{workspaceRoot}/scripts/platform/deploy-scope.test.mjs",
        "{workspaceRoot}/docs/components/render-deployment.md"
      ]
    },
    "syntax": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --check infra/test/blueprint.test.mjs && node --check infra/test/deploy-workflow.test.mjs && node --check scripts/platform/render-deploy.mjs && node --check scripts/platform/render-deploy.test.mjs && node --check scripts/platform/deploy-scope.mjs && node --check scripts/platform/deploy-scope.test.mjs && bash -n scripts/platform/hosted-smoke.sh && bash -n scripts/deploy/render-deploy.sh && bash -n scripts/deploy/google-oauth.sh"
      },
      "inputs": [
        "default",
        "{workspaceRoot}/scripts/platform/render-deploy.mjs",
        "{workspaceRoot}/scripts/platform/render-deploy.test.mjs",
        "{workspaceRoot}/scripts/platform/deploy-scope.mjs",
        "{workspaceRoot}/scripts/platform/deploy-scope.test.mjs",
        "{workspaceRoot}/scripts/platform/hosted-smoke.sh",
        "{workspaceRoot}/scripts/deploy/render-deploy.sh",
        "{workspaceRoot}/scripts/deploy/google-oauth.sh"
      ]
    }
  }
}
