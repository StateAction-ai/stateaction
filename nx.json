{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "neverConnectToCloud": true,
  "parallel": 2,
  "pluginsConfig": {
    "@nx/js": {
      "analyzePackageJson": true,
      "analyzeLockfile": true,
      "analyzeSourceFiles": false,
      "projectsAffectedByDependencyUpdates": "auto"
    }
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/dist/**/*",
      "!{projectRoot}/.next/**/*",
      "!{projectRoot}/.venv/**/*",
      "!{projectRoot}/.mypy_cache/**/*",
      "!{projectRoot}/.ruff_cache/**/*",
      "!{projectRoot}/**/__pycache__/**/*",
      "!{projectRoot}/**/*.tsbuildinfo",
      "!{projectRoot}/next-env.d.ts",
      "sharedGlobals",
      "jsToolchain",
      "pythonToolchain",
      "externalDeps"
    ],
    "production": [
      "default",
      "!{projectRoot}/test/**/*",
      "!{projectRoot}/tests/**/*",
      "!{projectRoot}/test-auth/**/*",
      "!{projectRoot}/test-integration/**/*",
      "!{projectRoot}/test-e2e/**/*",
      "!{projectRoot}/**/*.test.*"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/config/**/*",
      "{workspaceRoot}/.env.example",
      "{workspaceRoot}/.env.workflows.example",
      "{workspaceRoot}/Makefile",
      "{workspaceRoot}/.nxignore",
      "{workspaceRoot}/.prettierignore"
    ],
    "automationSources": [
      "{workspaceRoot}/scripts/automation/**/*",
      "{workspaceRoot}/.github/workflows/pr-policy.yml",
      "{workspaceRoot}/.github/workflows/auto-merge.yml"
    ],
    "repositoryDocs": [
      "{workspaceRoot}/AGENTS.md",
      "{workspaceRoot}/README.md",
      "{workspaceRoot}/docs/repository-workflow.md",
      "{workspaceRoot}/.github/pull_request_template.md"
    ],
    "runtimeTooling": [
      "{workspaceRoot}/scripts/platform/ci-smoke.sh",
      "{workspaceRoot}/scripts/platform/install-render.py",
      "{workspaceRoot}/scripts/platform/web.mjs"
    ],
    "flutterSources": [
      "{projectRoot}/**/*",
      "!{projectRoot}/build/**/*",
      "!{projectRoot}/.dart_tool/**/*",
      "!{projectRoot}/.flutter-plugins*",
      "!{projectRoot}/android/.gradle/**/*",
      "!{projectRoot}/android/local.properties",
      "!{projectRoot}/.env",
      "!{projectRoot}/.env.*",
      "sharedGlobals",
      "jsToolchain",
      "pythonToolchain",
      "flutterToolchain",
      "{workspaceRoot}/.tool-versions",
      "{workspaceRoot}/scripts/mobile/**/*",
      "{workspaceRoot}/scripts/platform/install-mobile-toolchain.py",
      "{workspaceRoot}/scripts/android_personal_device.py",
      "{workspaceRoot}/tests/test_android_personal_device.py",
      "{workspaceRoot}/scripts/platform/check-staged.mjs",
      "{workspaceRoot}/scripts/platform/check-staged-dart.test.mjs",
      "{workspaceRoot}/scripts/platform/hook-fixtures.mjs",
      "{workspaceRoot}/scripts/platform/check-staged.test.mjs",
      "!{projectRoot}/android/.kotlin/**/*",
      "!{projectRoot}/**/.cxx/**/*",
      "{workspaceRoot}/scripts/platform/runner_disk.py",
      "{workspaceRoot}/scripts/platform/test_mobile_runner_disk.py",
      "externalDeps"
    ],
    "jsToolchain": [
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/.npmrc",
      "{workspaceRoot}/.node-version",
      "{workspaceRoot}/.nvmrc",
      {
        "runtime": "node --version"
      },
      {
        "runtime": "pnpm --version"
      }
    ],
    "pythonToolchain": [
      "{workspaceRoot}/.python-version",
      {
        "runtime": "python3 --version"
      },
      {
        "runtime": "uv --version"
      }
    ],
    "flutterToolchain": [
      {
        "runtime": "java -version 2>&1"
      },
      {
        "runtime": "flutter --version --machine"
      }
    ],
    "repositoryConfig": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/lefthook.yml",
      "{workspaceRoot}/.github/workflows/*.yml",
      "{workspaceRoot}/scripts/local-ci/**/*",
      "{workspaceRoot}/docs/local-ci.md",
      "!{workspaceRoot}/scripts/local-ci/**/__pycache__/**/*"
    ],
    "externalDeps": [
      {
        "externalDependencies": []
      }
    ],
    "prettier": [
      {
        "externalDependencies": ["npm:prettier"]
      }
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "cache": true
    },
    "format": {
      "inputs": ["default"],
      "cache": true
    },
    "integration": {
      "cache": false,
      "parallelism": false
    },
    "syntax": {
      "inputs": ["default"],
      "cache": true
    },
    "e2e": {
      "cache": false,
      "parallelism": false
    }
  },
  "cacheDirectory": ".nx/cache"
}
